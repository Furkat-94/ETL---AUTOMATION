# Реальные данные и секреты в репозиторий не попадают никогда.
# Даже если настоящие выгрузки случайно окажутся в папке проекта,
# git их не увидит.

# секреты
.env
credentials.json

# выгрузки, кэш, архивы, база
data/*
!data/.gitkeep
cache/
*.xlsx
*.xls
*.csv
*.db

# служебное
__pycache__/
.ipynb_checkpoints/
.idea/
.vscode/
