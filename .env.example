# Образец настроек. Скопируй в .env и заполни — сам .env в git не попадает.
# В коде этих значений нет: скрипты читают их отсюда по имени.

# --- SQL-часть (config.py) ---
DB_URL=
SOURCE_URL=
SOURCE_USER=
SOURCE_PASSWORD=

# --- CRM: адрес в локальной сети и общий профиль (etl/) ---
CRM_HOST=crm.local
CRM_USER=report_user
CRM_PASSWORD=

# --- профили CRM для KPI анкетирования (etl/kpi_daily.py) ---
THETA_USER=
THETA_PASSWORD=
IOTA_USER=
IOTA_PASSWORD=
KAPPA_USER=
KAPPA_PASSWORD=

# --- ID Google-таблиц: часть ссылки между /d/ и /edit ---
ALPHA_SHEET_ID=
OMEGA_SHEET_ID=
MONITORING_SHEET_ID=
OPERATORS_SHEET_ID=
ANALYTICS_SHEET_ID=
KPI_SHEET_ID=
GAMMA_REPORT_SHEET_ID=

# --- демо-режим (etl/): 1 — писать в Excel-файлы в data/demo_output/
# вместо Google Sheets и не ходить в CRM. Демо-выгрузки: etl/generate_etl_demo.py
